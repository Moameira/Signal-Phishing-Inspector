{
  "manifest_version": 3,
  "name": "Signal — Phishing Inspector for Gmail",
  "version": "0.1.0",
  "description": "Scores the email you have open in Gmail for phishing risk and shows why.",
  "permissions": [],
  "host_permissions": ["https://mail.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Signal — Phishing Inspector"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
